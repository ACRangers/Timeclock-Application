# Railway Postgres — SHARED with hvac-tracker.
# Local dev: the public proxy URL (e.g. postgres://...@mainline.proxy.rlwy.net:15967/railway)
# On Railway, same project as hvac-tracker: postgres://...@postgres.railway.internal:5432/railway
DATABASE_URL=

# Signs the session cookie. Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random one is generated at boot and everyone is logged out on every restart.
SESSION_SECRET=

PORT=3000
