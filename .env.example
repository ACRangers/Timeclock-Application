# Railway Postgres — SHARED with hvac-tracker.
# Local dev: the public proxy URL (e.g. postgres://...@mainline.proxy.rlwy.net:15967/railway)
# On Railway, same project as hvac-tracker: postgres://...@postgres.railway.internal:5432/railway
DATABASE_URL=

# Signs the session cookie. Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random one is generated at boot and everyone is logged out on every restart.
SESSION_SECRET=

# ServiceTitan — the source of truth for clocked hours (Payroll → Timesheets).
# Same API app as hvac-tracker/acr-tracker, but it needs one extra read scope:
#   tn.prl.nonjobtimesheets:r   (required — the punches)
#   tn.prl.timesheetcodes:r     (labels a punch: Regular / Lunch / PTO)
# Without those the sync logs 403 and no hours appear.
ST_TENANT_ID=
ST_CLIENT_ID=
ST_CLIENT_SECRET=
ST_AUTH_URL=https://auth.servicetitan.io/connect/token
ST_API_URL=https://api.servicetitan.io
ST_APP_KEY=

PORT=3000
